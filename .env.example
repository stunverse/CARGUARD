# =====================================================================
# CarGuard AI — Environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# =====================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Plan limits (inspections/reports per month). OFF during development.
# Set to "true" before official launch to enforce quotas.
ENFORCE_QUOTAS=false

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for inspection photos (private).
STORAGE_BUCKET_INSPECTION_PHOTOS=inspection-photos
# Storage bucket for engine-start audio/video (private).
STORAGE_BUCKET_ENGINE_AUDIO=engine-audio
# Storage bucket for engine & mechanical photos/videos/docs (private).
STORAGE_BUCKET_MECHANICAL=mechanical-media

# --- OpenAI (vision + structured analysis) ---
OPENAI_API_KEY=
# Vision-capable model used for photo quality + damage analysis.
OPENAI_VISION_MODEL=gpt-4o
# Audio-capable model for engine-start audio analysis (optional).
OPENAI_AUDIO_MODEL=gpt-4o-audio-preview

# --- Paid per-VIN history (VinAudit / NMVTIS) ---
# Wholesale provider for full US title/salvage history (pay-per-report).
VINAUDIT_API_KEY=
# Override only if your VinAudit account uses a different endpoint.
VINAUDIT_API_URL=https://api.vinaudit.com/v2/pullreport
# Price charged to the user via Stripe (cents) + currency. Default $14.99.
VIN_HISTORY_PRICE_CENTS=1499
VIN_HISTORY_CURRENCY=usd

# --- Vehicle lookup (auto-fill the inspection form) ---
# VIN decode uses the free NHTSA vPIC API (no key needed).
# Plate lookup is region-specific & usually paid. UK (DVLA) adapter is built-in:
DVLA_API_KEY=
# TODO: add keys for other regional plate providers (e.g. France/SIV) as needed.

# --- Stripe Billing (optional for MVP — leave blank to disable) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring price IDs from your Stripe products (one per paid plan).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
